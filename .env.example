# =========================================================
# content-studio · 服务端配置
# 部署时复制为 .env (不要提交到 git!),填入真实值
# =========================================================

# ---- LLM 后端(Anthropic 兼容接口)---------------------
# 模型 profile 名(展示在 UI 顶栏)
STUDIO_LLM_NAME=deepseek-v4-pro

# 实际调用的 model id
STUDIO_LLM_MODEL=deepseek-v4-pro

# Anthropic 兼容的 base URL(必须带尾 /)
STUDIO_LLM_BASE_URL=https://api.deepseek.com/anthropic/

# API key
STUDIO_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 单次最大输出 token(默认 8000)
# STUDIO_LLM_MAX_TOKENS=8000

# ---- 服务端口 -----------------------------------------
# Express 后端端口(默认 5174)
# PORT=5174

# ---- 数据持久化 ---------------------------------------
# 草稿存储目录(默认 ./data,会自动创建)
# STUDIO_DATA_DIR=./data

# ---- we-mp-rss 数据源 ---------------------------------
# Express 后端会调 we-mp-rss API 拉订阅源列表(/api/v1/wx/mps)
# 默认 http://127.0.0.1:8001 (服务器上 we-mp-rss 跟 Express 同机)
# WEMPRSS_BASE_URL=http://127.0.0.1:8001

# 拉订阅源需要 we-mp-rss 的 Access Key (AK/SK)
# 怎么拿:
#   1. 浏览器登录 we-mp-rss 管理后台
#   2. 顶栏「Access Key」→ 新建一个 AK
#   3. 复制 access_key 和 secret_key 到下面两行
# 不填的话拉订阅源会 401,但 LLM 改写不受影响
# WEMPRSS_AK=WK_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WEMPRSS_SK=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 小红书数据源 (TikHub) ----------------------------
# 小红书搜索走 TikHub app_v2 接口,每次搜索约 $0.01(需 TikHub 真实余额,免费额度不支持)
# 申请: https://user.tikhub.io  →  生成 API Key
# TIKHUB_BASE_URL=https://api.tikhub.io
# TIKHUB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
